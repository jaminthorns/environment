# Sizing/positioning
font-size = 9
window-height = 25
window-width = 100
window-padding-x = 8
window-padding-y = 8

# Colors
palette = 0=#21222c
palette = 1=#ff5555
palette = 2=#50fa7b
palette = 3=#f1fa8c
palette = 4=#bd93f9
palette = 5=#ff79c6
palette = 6=#8be9fd
palette = 7=#f8f8f2
palette = 8=#6272a4
palette = 9=#ff6e6e
palette = 10=#69ff94
palette = 11=#ffffa5
palette = 12=#d6acff
palette = 13=#ff92df
palette = 14=#a4ffff
palette = 15=#ffffff
background = #282a36
foreground = #f8f8f2
cursor-color = #f8f8f2
cursor-text = #282a36
selection-foreground = #f8f8f2
selection-background = #44475a

# Tab/pane control
keybind = ctrl+shift+n=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+left=previous_tab
keybind = ctrl+shift+right=next_tab
keybind = ctrl+shift+[=goto_split:left
keybind = ctrl+shift+]=goto_split:right
keybind = ctrl+shift+|=new_split:right
keybind = ctrl+shift+alt+|=new_split:down

# Cursor control
keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = alt+delete=esc:d
keybind = {{command_key}}+left=text:\x01
keybind = {{command_key}}+right=text:\x05
keybind = {{command_key}}+up=csi:1;5H
keybind = {{command_key}}+down=csi:1;5F
keybind = {{command_key}}+backspace=text:\x15
keybind = {{command_key}}+delete=text:\x0B

# Screen clearing
keybind = {{command_key}}+k=clear_screen

# Command navigation
keybind = ctrl+shift+up=jump_to_prompt:-1
keybind = ctrl+shift+down=jump_to_prompt:1

# Workaround for copy/paste/search
keybind = ctrl+c=copy_to_clipboard
keybind = ctrl+alt+c=text:\x03
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+alt+v=text:\x16
keybind = ctrl+f=start_search
keybind = ctrl+alt+f=text:\x06
