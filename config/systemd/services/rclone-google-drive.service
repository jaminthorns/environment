[Unit]
Description=Mount Google Drive folder with rclone

[Service]
Type=notify
ExecStartPre=/usr/bin/mkdir -p %h/Drive
ExecStart=/home/linuxbrew/.linuxbrew/bin/rclone mount google_drive: %h/Drive --vfs-cache-mode full --drive-export-formats link.html
ExecStop=/bin/fusermount -u -z %h/Drive
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
